{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "Truffle"
  ],
  "contact": {
    "homepage": "https://github.com/ooTruffle/NickHider",
    "sources": "https://github.com/ooTruffle/NickHider",
    "issues": "https://github.com/ooTruffle/NickHider/issues"
  },
  "icon": "assets/${mod_id}/icon.png",
  "environment": "client",
  "entrypoints": {
    "init": [
      "${base_group}.NickHider"
    ]
  },
  "mixins": [
    "mixins.${mod_id}.json",
    "mixins.${mod_id}.argentum.json"
  ],
  "depends": {
    "java": ">=${java_version}",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "osl-entrypoints": "*",
    "osl-keybinds": "*",
    "oneconfigv1": ">=${oneconfig_version}"
  },
  "custom": {
    "modupdatechecker": {
      "github": "ooTruffle/NickHider"
    }
  }
}
